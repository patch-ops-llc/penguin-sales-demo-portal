# Copy this file to .env for local development. Every variable the app reads is listed here.
# Never commit real values.

# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/penguin_demo_portal"

# Public base URL of the app, no trailing slash. Used to build invite and sign-in links.
# Session cookies are marked Secure when this starts with https://.
APP_URL="http://localhost:3000"

# Long random string used to hash session, invite, and sign-in link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Comma-separated emails of the first admins. The seed creates (or promotes) an admin account
# for each one on every start.
ADMIN_EMAILS=""

# One-time bootstrap password (10 characters or more) for admin accounts that have no password yet.
# The seed never overwrites an existing password unless ADMIN_PASSWORD_RESET is true.
# Remove this variable after the first login.
ADMIN_INITIAL_PASSWORD=""

# Set to "true" for one deploy to force ADMIN_INITIAL_PASSWORD onto every ADMIN_EMAILS account,
# even those that already have a password. Remove it right after that deploy.
ADMIN_PASSWORD_RESET=""

# Optional. Resend API key for invite, password-reset, and sign-in link email. Invite and reset
# links are always shown to the admin to copy. When this is unset no email is sent, and the
# "email me a sign-in link" option is hidden.
RESEND_API_KEY=""

# Optional. From address for outgoing email. The domain must be verified in Resend.
EMAIL_FROM="Penguin Sales Demo Portal <demo-portal@example.com>"

# Optional. Session lifetime in days, sliding. Defaults to 30.
SESSION_TTL_DAYS="30"

# Optional. How long access events and demo runs are kept, in days. Defaults to 730 (24 months).
LOG_RETENTION_DAYS="730"

# Optional: Google sign-in. The button shows only when both are set. Access stays invite-only.
# In Google Cloud Console, set the authorized redirect URI to <APP_URL>/auth/google/callback
# and the authorized JavaScript origin to <APP_URL>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Live agent demos (optional) ----
# Model provider keys. Read server-side only. A missing key hides that provider and the demo
# runs in scripted mode. Never commit a value and never paste one into chat.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Deferred: no adapter yet. Reserved so Grok can be added without a config change.
XAI_API_KEY=

# Optional. Comma-separated allowlist of providers to enable among those with a key: anthropic, openai.
# Empty means every provider with a key.
AGENT_PROVIDERS=""

# Optional. Pinned model per provider. Defaults: claude-sonnet-5-5, gpt-6.2-sol.
AGENT_MODEL_ANTHROPIC=""
AGENT_MODEL_OPENAI=""

# Set to "1" to enable the deterministic mock provider (no network, no key). Used by the e2e tests.
AGENT_MOCK=""

# Caps. Spend is estimated from list prices per provider per UTC day.
AGENT_DAILY_BUDGET_USD="25"
AGENT_SESSION_MAX_TURNS="40"
AGENT_USER_TURNS_PER_MINUTE="10"

# Set to "true" to keep the model's replies (not the rep's input) on agent_turn rows for review. Off by default.
AGENT_LOG_TRANSCRIPTS=""
